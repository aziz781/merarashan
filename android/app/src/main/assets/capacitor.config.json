{
	"appId": "pk.merarashan.app",
	"appName": "merarashan",
	"webDir": "dist",
	"plugins": {
		"FirebaseMessaging": {
			"presentationOptions": [
				"alert",
				"badge",
				"sound"
			]
		},
		"PushNotifications": {
			"presentationOptions": [
				"alert",
				"badge",
				"sound"
			]
		}
	},
	"experimental": {
		"ios": {
			"spm": {
				"packageOptions": {
					"@capacitor-firebase/messaging": {
						"symlink": true
					}
				}
			}
		}
	}
}
